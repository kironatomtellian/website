---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ConcertRow from "../components/ConcertRow.astro";
import { withBase } from "../lib/url";
import { type Concert } from "../lib/concert";
import past from "../data/concerts-past.json";

const concerts = past as Concert[];

// Column-by-column split so the left column reads top-to-bottom by date,
// then the right column.
const mid = Math.ceil(concerts.length / 2);
const colLeft = concerts.slice(0, mid);
const colRight = concerts.slice(mid);
---

<Layout title="Previous events · Kiron Atom Tellian">
  <PageHero
    title="Previous events"
    eyebrow="Archive"
    image="/img/archive-hero.jpg"
    imageAlt="Kiron Atom Tellian, hands at the keyboard."
    imagePosition="25% 35%"
  />

  <section class="archive container">
    <div class="archive__columns">
      {[colLeft, colRight].map((col) => (
        <div class="archive__column">
          {col.map((c) => <ConcertRow concert={c} showTickets={false} />)}
        </div>
      ))}
    </div>

    <p class="archive__cta reveal">
      <a class="link-quiet" href={withBase("/schedule")}>
        Upcoming concerts <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</Layout>

<style>
  .archive {
    padding-block: var(--section-y-tight) var(--section-y);
    max-width: 1080px;
  }

  @media (min-width: 1280px) {
    .archive {
      max-width: 1440px;
    }
  }

  .archive__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  /* Two columns only kick in once each column is wide enough that a
     typical concert entry stays within ~4 lines. */
  @media (min-width: 1400px) {
    .archive__columns {
      grid-template-columns: 1fr 1fr;
      gap: 0 var(--space-12);
    }
  }

  .archive__cta {
    text-align: center;
    margin-top: var(--space-12);
  }
</style>
