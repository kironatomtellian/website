---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/url";
import { cityOf, groupByYear, groupRuns, runLabel, whatOf, withLineOf } from "../lib/concert";
import { pastConcerts } from "../lib/season";

const years = groupByYear(pastConcerts);
const first = years[years.length - 1]?.year;
---

<Layout title="Past concerts · Kiron Atom Tellian">
  <PageHero
    eyebrow="Past concerts"
    title={`${pastConcerts.length} concerts,`}
    italic={`since ${first}`}
    image="/img/archive-hero.jpg"
    imageAlt=""
    imagePosition="50% 25%"
  />

  <nav class="archive-years container" aria-label="Years" data-stagger>
    {years.map((y) => <a class="mono" href={`#y${y.year}`}>{y.year}</a>)}
  </nav>

  <section class="archive container">
    {years.map((y) => (
      <div class="archive__year" id={`y${y.year}`}>
        <div class="archive__head">
          <div class="archive__year-n" data-split>{y.year}</div>
          <div class="archive__count">{y.items.length} concerts</div>
        </div>
        <ol class="archive__rows" data-stagger>
          {groupRuns(y.items).map((r) => (
            <li class="archive__row">
              <span class="archive__date">{runLabel(r).days}<span class="archive__sub">{runLabel(r).sub}</span></span>
              <span class="archive__city">{cityOf(r[0])}</span>
              <span class="archive__what">{whatOf(r[0])}<span class="archive__sub">{withLineOf(r[0])}</span></span>
            </li>
          ))}
        </ol>
      </div>
    ))}
    <a class="link-line archive__cta" href={withBase("/schedule")}>Upcoming concerts →</a>
  </section>
</Layout>

<style>
  .archive-years {
    position: sticky;
    top: var(--nav-h-scrolled);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4);
    background: var(--black);
    border-bottom: 1px solid var(--rule);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
  }

  .archive-years a {
    color: var(--muted);
    transition: color 200ms;
  }

  .archive-years a:hover {
    color: var(--vermilion);
  }

  .archive {
    padding-block: var(--space-8) var(--section-y);
  }

  .archive__year {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-20);
    scroll-margin-top: calc(var(--nav-h) + 4rem);
  }

  .archive__head {
    position: sticky;
    top: calc(var(--nav-h) + 4rem);
    align-self: start;
  }

  .archive__year-n {
    font-family: var(--display);
    font-size: 4.5rem;
    line-height: 0.9;
    color: var(--vermilion);
  }

  .archive__count {
    margin-top: var(--space-2);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .archive__rows {
    border-top: 1px solid var(--rule);
  }

  .archive__row {
    display: grid;
    grid-template-columns: 8.75rem minmax(0, 1.6fr) minmax(0, 2.6fr);
    gap: var(--space-6);
    align-items: start;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
    transition: background 300ms;
  }

  .archive__row:hover {
    background: rgba(239, 235, 227, 0.03);
  }

  .archive__date {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 0.375rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .archive__sub {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--sans);
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: var(--muted);
  }

  .archive__what .archive__sub {
    font-size: 0.9375rem;
  }

  .archive__city {
    font-family: var(--display);
    font-size: clamp(1.625rem, 2.6vw, 2.5rem);
    line-height: 1;
  }

  .archive__what {
    padding-top: 0.25rem;
    line-height: 1.45;
  }

  .archive__cta {
    margin-top: var(--space-16);
  }

  @media (max-width: 900px) {
    .archive__year { grid-template-columns: 1fr; }
    .archive__head { position: static; }
    .archive__row { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
