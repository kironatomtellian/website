---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ConcertRow from "../components/ConcertRow.astro";
import { withBase } from "../lib/url";
import { type Concert, ensembleLabel, daysUntil, groupByMonth } from "../lib/concert";
import upcoming from "../data/concerts-upcoming.json";

const concerts = upcoming as Concert[];
const featured = concerts[0];
const rest = concerts.slice(1);
const grouped = groupByMonth(rest);

// Split items column-by-column for the desktop two-column layout: first
// half goes down the left column, second half down the right. This keeps
// strict chronological reading order within each column.
type Entry =
  | { kind: "month"; key: string; label: string }
  | { kind: "concert"; key: string; concert: Concert };
const entries: Entry[] = [];
for (const g of grouped) {
  entries.push({ kind: "month", key: `m-${g.key}`, label: g.label });
  for (const c of g.items) {
    entries.push({ kind: "concert", key: `c-${c.date}-${c.venue}`, concert: c });
  }
}
const mid = Math.ceil(entries.length / 2);
const colLeft = entries.slice(0, mid);
const colRight = entries.slice(mid);
---

<Layout title="Schedule · Kiron Atom Tellian">
  <PageHero
    title="Schedule"
    eyebrow="Upcoming concerts"
    image="/img/hero-4_vor_dem_klavier.jpg"
    imageAlt="Kiron Atom Tellian seated at a grand piano."
  />

  <section class="schedule container">
    {featured && (
      <article class="schedule__featured reveal">
        <div class="schedule__featured-top">
          <div>
            <p class="display-l schedule__featured-date">{featured.displayDate}</p>
            {ensembleLabel(featured) && (
              <p class="small accent schedule__featured-ensemble">{ensembleLabel(featured)}</p>
            )}
            <p class="h2 schedule__featured-programme">{featured.programme}</p>
            <p class="schedule__featured-venue">{featured.venue}</p>
          </div>
          {featured.date && (
            <div class="schedule__featured-count">
              <span class="schedule__featured-count-num accent">{daysUntil(featured.date)}</span>
              <span class="eyebrow muted">days</span>
            </div>
          )}
        </div>
        {featured.ticketsUrl && (
          <p class="schedule__featured-cta">
            <a class="link-quiet" href={featured.ticketsUrl} target="_blank" rel="noopener">
              Details &amp; tickets <span aria-hidden="true">→</span>
            </a>
          </p>
        )}
      </article>
    )}

    <div class="schedule__columns reveal">
      {[colLeft, colRight].map((col) => (
        <div class="schedule__column">
          {col.map((e) =>
            e.kind === "month" ? (
              <h2 class="display-l accent schedule__month">{e.label}</h2>
            ) : (
              <ConcertRow concert={e.concert} />
            ),
          )}
        </div>
      ))}
    </div>

    <p class="schedule__cta reveal">
      <a class="link-quiet" href={withBase("/schedule-archive")}>
        Past concerts <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</Layout>

<style>
  .schedule {
    padding-block: var(--section-y-tight) var(--section-y);
    max-width: 1080px;
  }

  .schedule__featured {
    padding-block: var(--space-8);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-16);
  }

  .schedule__featured-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .schedule__featured-date {
    margin: 0 0 var(--space-1);
  }

  .schedule__featured-ensemble {
    margin: 0 0 var(--space-3);
  }

  .schedule__featured-programme {
    margin: 0 0 var(--space-2);
    font-weight: 400;
  }

  .schedule__featured-venue {
    margin: 0;
    font-size: 1.0625rem;
  }

  .schedule__featured-count {
    text-align: right;
    flex-shrink: 0;
  }

  .schedule__featured-count-num {
    display: block;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .schedule__featured-cta {
    margin-top: var(--space-4);
  }

  .schedule__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-12);
  }

  .schedule__column > * + * {
    margin-top: 0;
  }

  .schedule__month {
    margin: var(--space-8) 0 var(--space-2);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
  }

  .schedule__column > .schedule__month:first-child {
    margin-top: 0;
  }

  .schedule__cta {
    text-align: center;
    margin-top: var(--space-16);
  }

  @media (max-width: 768px) {
    .schedule__featured-top {
      flex-direction: column;
    }
    .schedule__featured-count {
      text-align: left;
    }
    .schedule__columns {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
