---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/url";
import { cityOf, continentOf, countryOf, groupRuns, runLabel, whatOf as what, withLineOf as withLine } from "../lib/concert";
import { upcomingConcerts, pastConcerts } from "../lib/season";

// The page always shows the whole season, played and coming, so it never looks empty.
const year = new Date().getFullYear();
const played = pastConcerts.filter((c) => c.date.startsWith(String(year))).reverse();
const season = [...played, ...upcomingConcerts];
const years = [...new Set(season.map((c) => c.date.slice(0, 4)))];
const stats = [
  { n: season.length, label: `concerts in ${years.join(" and ")}` },
  { n: new Set(season.map(cityOf)).size, label: "cities" },
  { n: new Set(season.map(countryOf)).size, label: "countries" },
  { n: new Set(season.map(continentOf)).size, label: "continents" },
];

// One column per month from January of this year, one dot per concert.
const months = Array.from({ length: 18 }, (_, i) => {
  const d = new Date(Date.UTC(year, i, 1));
  const key = d.toISOString().slice(0, 7);
  return {
    letter: d.toLocaleString("en", { month: "narrow", timeZone: "UTC" }),
    year: d.getUTCMonth() === 0 ? String(d.getUTCFullYear()) : "",
    played: played.filter((c) => c.date.startsWith(key)).length,
    coming: upcomingConcerts.filter((c) => c.date.startsWith(key)).length,
  };
});

---

<Layout title="Schedule · Kiron Atom Tellian">
  <section class="schedule container">
    <h1 class="display-xxl schedule__title" data-split>Schedule</h1>

    <dl class="schedule__stats" data-stagger>
      {stats.map((s) => (
        <div>
          <dt class="schedule__stat-n" data-count>{s.n}</dt>
          <dd class="schedule__stat-l">{s.label}</dd>
        </div>
      ))}
    </dl>

    <div class="schedule__timeline" aria-hidden="true" data-stagger>
      {months.map((m) => (
        <div class="schedule__month-col">
          <div class="schedule__dots">
            {Array.from({ length: m.played }, () => <span class="schedule__dot" />)}
            {Array.from({ length: m.coming }, () => <span class="schedule__dot schedule__dot--coming" />)}
          </div>
          <span class="mono">{m.letter}</span>
          <span class="mono schedule__year">{m.year}</span>
        </div>
      ))}
    </div>
    <p class="mono schedule__legend"><span class="schedule__legend-coming">●</span> Coming up <span>●</span> Played</p>

    <h2 class="mono schedule__label schedule__label--coming">Coming up</h2>
    <ol class="schedule__rows" data-stagger>
      {groupRuns(upcomingConcerts).map((r) => (
        <li>
          <a class="schedule__row row-sweep" href={r[0].ticketsUrl ?? withBase("/contact")} target={r[0].ticketsUrl ? "_blank" : undefined} rel="noopener noreferrer">
            <span class="schedule__date">{runLabel(r).days}<span class="schedule__sub">{runLabel(r).sub}</span></span>
            <span class="schedule__city">{cityOf(r[0])}</span>
            <span class="schedule__what">{what(r[0])}<span class="schedule__sub">{withLine(r[0])}</span></span>
            <span class="schedule__arrow arrow-slide" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    {played.length > 0 && (
      <>
        <h2 class="mono schedule__label">Played in {year}</h2>
        <ol class="schedule__rows" data-stagger>
          {groupRuns([...played].reverse()).map((r) => (
            <li>
              <div class="schedule__row schedule__row--past">
                <span class="schedule__date">{runLabel(r).days}<span class="schedule__sub">{runLabel(r).sub}</span></span>
                <span class="schedule__city">{cityOf(r[0])}</span>
                <span class="schedule__what">{what(r[0])}<span class="schedule__sub">{withLine(r[0])}</span></span>
                <span class="schedule__arrow" aria-hidden="true"></span>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}

    <a class="link-line schedule__past" href={withBase("/schedule-archive")}>All past concerts →</a>
  </section>
</Layout>

<style>
  .schedule {
    padding-block: calc(var(--nav-h) + var(--space-16)) var(--section-y);
  }

  .schedule__title {
    margin: 0 0 var(--space-12);
  }

  .schedule__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12.5rem, 40%), 1fr));
    gap: var(--space-8);
    margin: 0 0 var(--space-12);
  }

  .schedule__stat-n {
    font-family: var(--display);
    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 0.9;
  }

  .schedule__stat-l {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }

  .schedule__timeline {
    display: grid;
    grid-template-columns: repeat(18, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 1.75rem 0 1rem;
    border-block: 1px solid var(--rule);
  }

  .schedule__month-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .schedule__dots {
    height: 4.625rem;
    display: flex;
    flex-direction: column-reverse;
    flex-wrap: wrap-reverse;
    align-content: center;
    gap: 0.25rem;
  }

  /* Dots drop into place month by month. */
  :global(.motion) .schedule__timeline .schedule__dot {
    transform: scale(0);
    transition: transform 600ms var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 80ms + 300ms);
  }

  :global(.motion) .schedule__timeline.is-in .schedule__dot {
    transform: none;
  }

  .schedule__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--muted);
  }

  .schedule__dot--coming,
  .schedule__legend-coming {
    background: var(--vermilion);
  }

  .schedule__legend-coming {
    background: none;
    color: var(--vermilion);
  }

  .schedule__year {
    min-height: 1em;
    font-size: 0.6875rem;
  }

  .schedule__legend {
    margin: 0.875rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .schedule__legend span + span {
    margin-left: var(--space-4);
  }

  .schedule__label {
    margin: var(--space-20) 0 var(--space-6);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .schedule__label--coming {
    color: var(--vermilion);
  }

  .schedule__rows {
    border-top: 1px solid var(--rule);
  }

  /* Same columns as the concerts board on the home page. */
  .schedule__row {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 2.2fr) minmax(0, 2.6fr) 1.5rem;
    gap: var(--space-6);
    align-items: start;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .schedule__row--past {
    color: var(--muted);
  }

  a.schedule__row:hover .schedule__arrow {
    color: var(--accent);
  }

  .schedule__date {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 0.375rem;
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .schedule__sub {
    display: block;
    font-family: var(--sans, inherit);
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: var(--muted);
  }

  .schedule__what .schedule__sub {
    margin-top: 0.25rem;
    font-size: 1rem;
  }

  .schedule__city {
    font-family: var(--display);
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1;
  }

  .schedule__row--past .schedule__city {
    opacity: 0.7;
  }

  .schedule__what {
    padding-top: 0.25rem;
    line-height: 1.45;
  }

  .schedule__arrow {
    font-size: 1.25rem;
  }

  .schedule__past {
    margin-top: var(--space-12);
  }

  @media (max-width: 768px) {
    .schedule__row {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-4);
    }
    .schedule__date,
    .schedule__what { grid-column: 1 / -1; }
    .schedule__arrow { grid-row: 2; grid-column: 2; }
    .schedule__timeline { gap: 0; }
    .schedule__dot { width: 0.5rem; height: 0.5rem; }
  }
</style>
