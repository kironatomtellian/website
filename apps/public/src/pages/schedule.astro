---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/url";
import { cityOf, continentOf, countryOf, groupRuns, runLabel, whatOf as what, withLineOf as withLine } from "../lib/concert";
import { upcomingConcerts, pastConcerts } from "../lib/season";

// The page shows the whole career at a glance, then the season in detail.
const year = new Date().getFullYear();
const played = pastConcerts.filter((c) => c.date.startsWith(String(year))).reverse();
const all = [...pastConcerts, ...upcomingConcerts];
const firstYear = Number(all.reduce((m, c) => (c.date < m ? c.date : m), all[0].date).slice(0, 4));
const lastYear = Number(all.reduce((m, c) => (c.date > m ? c.date : m), all[0].date).slice(0, 4));
const stats = [
  { n: all.length, label: `concerts since ${firstYear}` },
  { n: new Set(all.map((c) => c.venue)).size, label: "stages" },
  { n: new Set(all.map(countryOf)).size, label: "countries" },
  { n: new Set(all.map(continentOf)).size, label: "continents" },
];

// One column per year, one dot per concert: grey played, red still to come.
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => {
  const y = String(firstYear + i);
  const done = pastConcerts.filter((c) => c.date.startsWith(y)).length;
  const coming = upcomingConcerts.filter((c) => c.date.startsWith(y)).length;
  return { y, done, coming, total: done + coming, now: Number(y) === year };
});

---

<Layout title="Schedule · Kiron Atom Tellian">
  <section class="schedule container">
    <h1 class="display-xxl schedule__title" data-split>Schedule</h1>

    <dl class="schedule__stats" data-stagger>
      {stats.map((s) => (
        <div>
          <dt class="schedule__stat-n" data-count>{s.n}</dt>
          <dd class="schedule__stat-l">{s.label}</dd>
        </div>
      ))}
    </dl>

    <div class="schedule__timeline" aria-label="Concerts per year" data-stagger>
      {years.map((y) => (
        <div class={`schedule__year-col ${y.now ? "is-now" : ""}`}>
          <span class="schedule__year-n">{y.total}</span>
          <div class="schedule__dots" aria-hidden="true">
            {Array.from({ length: y.done }, () => <span class="schedule__dot" />)}
            {Array.from({ length: y.coming }, () => <span class="schedule__dot schedule__dot--coming" />)}
          </div>
          <span class="mono schedule__year">{y.y}</span>
        </div>
      ))}
    </div>
    <p class="mono schedule__legend"><span>●</span> Played <span class="schedule__legend-coming">●</span> Coming up</p>

    <h2 class="mono schedule__label schedule__label--coming">Coming up</h2>
    <ol class="schedule__rows" data-stagger>
      {groupRuns(upcomingConcerts).map((r) => (
        <li>
          <a class="schedule__row row-sweep" href={r[0].ticketsUrl ?? withBase("/contact")} target={r[0].ticketsUrl ? "_blank" : undefined} rel="noopener noreferrer">
            <span class="schedule__date">{runLabel(r).days}<span class="schedule__sub">{runLabel(r).sub}</span></span>
            <span class="schedule__city">{cityOf(r[0])}</span>
            <span class="schedule__what">{what(r[0])}<span class="schedule__sub">{withLine(r[0])}</span></span>
            <span class="schedule__arrow arrow-slide" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    {played.length > 0 && (
      <>
        <h2 class="mono schedule__label">Played in {year}</h2>
        <ol class="schedule__rows" data-stagger>
          {groupRuns([...played].reverse()).map((r) => (
            <li>
              <div class="schedule__row schedule__row--past">
                <span class="schedule__date">{runLabel(r).days}<span class="schedule__sub">{runLabel(r).sub}</span></span>
                <span class="schedule__city">{cityOf(r[0])}</span>
                <span class="schedule__what">{what(r[0])}<span class="schedule__sub">{withLine(r[0])}</span></span>
                <span class="schedule__arrow" aria-hidden="true"></span>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}

    <a class="link-line schedule__past" href={withBase("/schedule-archive")}>Past concerts →</a>
  </section>
</Layout>

<style>
  .schedule {
    padding-block: calc(var(--nav-h) + var(--space-16)) var(--section-y);
  }

  .schedule__title {
    margin: 0 0 var(--space-12);
  }

  .schedule__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12.5rem, 40%), 1fr));
    gap: var(--space-8);
    margin: 0 0 var(--space-12);
  }

  .schedule__stat-n {
    font-family: var(--display);
    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 0.9;
  }

  .schedule__stat-l {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }

  .schedule__timeline {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-items: end;
    padding: var(--space-8) 0 var(--space-4);
    border-block: 1px solid var(--rule);
  }

  .schedule__year-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
  }

  .schedule__year-n {
    font-family: var(--display);
    font-size: 2rem;
    line-height: 1;
    color: var(--bone);
  }

  .schedule__year-col.is-now .schedule__year,
  .schedule__year-col.is-now .schedule__year-n {
    color: var(--vermilion);
  }

  /* Dots fill four to a row from the bottom, so each year reads as a bar. */
  .schedule__dots {
    display: grid;
    grid-template-columns: repeat(4, 0.625rem);
    gap: 0.3125rem;
    direction: rtl;
    transform: scaleY(-1);
  }

  /* Dots drop into place year by year. */
  :global(.motion) .schedule__timeline .schedule__dot {
    transform: scale(0);
    transition: transform 600ms var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 80ms + 300ms);
  }

  :global(.motion) .schedule__timeline.is-in .schedule__dot {
    transform: none;
  }

  .schedule__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--muted);
  }

  .schedule__dot--coming,
  .schedule__legend-coming {
    background: var(--vermilion);
  }

  .schedule__legend-coming {
    background: none;
    color: var(--vermilion);
  }

  .schedule__year {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .schedule__legend {
    margin: 0.875rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .schedule__legend span + span {
    margin-left: var(--space-4);
  }

  .schedule__label {
    margin: var(--space-20) 0 var(--space-6);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .schedule__label--coming {
    color: var(--vermilion);
  }

  .schedule__rows {
    border-top: 1px solid var(--rule);
  }

  /* Same columns as the concerts board on the home page. */
  .schedule__row {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 2.2fr) minmax(0, 2.6fr) 1.5rem;
    gap: var(--space-6);
    align-items: start;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .schedule__row--past {
    color: var(--muted);
  }

  a.schedule__row:hover .schedule__arrow {
    color: var(--accent);
  }

  .schedule__date {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 0.375rem;
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .schedule__sub {
    display: block;
    font-family: var(--sans, inherit);
    font-size: 0.8125rem;
    letter-spacing: 0;
    color: var(--muted);
  }

  .schedule__what .schedule__sub {
    margin-top: 0.25rem;
    font-size: 1rem;
  }

  .schedule__city {
    font-family: var(--display);
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1;
  }

  .schedule__row--past .schedule__city {
    opacity: 0.7;
  }

  .schedule__what {
    padding-top: 0.25rem;
    line-height: 1.45;
  }

  .schedule__arrow {
    font-size: 1.25rem;
  }

  .schedule__past {
    margin-top: var(--space-12);
  }

  @media (max-width: 768px) {
    .schedule__row {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-4);
    }
    .schedule__date,
    .schedule__what { grid-column: 1 / -1; }
    .schedule__arrow { grid-row: 2; grid-column: 2; }
    .schedule__timeline { gap: 0.25rem; }
    .schedule__dots { grid-template-columns: repeat(2, 0.4375rem); gap: 0.1875rem; }
    .schedule__dot { width: 0.4375rem; height: 0.4375rem; }
    .schedule__year-n { font-size: 1.25rem; }
    .schedule__year { font-size: 0.5625rem; }
  }
</style>
