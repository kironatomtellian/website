---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import PressQuote from "../components/PressQuote.astro";
import { withBase } from "../lib/url";
import data from "../data/press.json";
---

<Layout title="Press · Kiron Atom Tellian">
  <PageHero
    title={data.hero.title}
    eyebrow={data.hero.eyebrow}
    image={data.hero.image}
    imageAlt={data.hero.imageAlt}
    imagePosition="22% 22%"
  />

  <section class="press container">
    <div class="press__grid">
      {data.quotes.map((q) => (
        <PressQuote
          publication={q.publication}
          byline={q.byline}
          quote={q.quote}
          date={q.date}
          url={q.url}
          align="left"
        />
      ))}
    </div>

    <p class="press__cta reveal">
      <a class="link-quiet" href={withBase("/about")}>
        Read the biography <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
</Layout>

<style>
  .press {
    padding-block: var(--section-y-tight) var(--section-y);
  }

  .press__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8) var(--space-16);
    max-width: 64ch;
    margin-inline: auto;
  }

  @media (min-width: 1100px) {
    .press__grid {
      grid-template-columns: 1fr 1fr;
      max-width: 1280px;
    }
  }

  @media (min-width: 1600px) {
    .press__grid {
      grid-template-columns: repeat(3, 1fr);
      max-width: 1700px;
    }
  }

  .press__cta {
    text-align: center;
    margin-top: var(--space-12);
  }
</style>
