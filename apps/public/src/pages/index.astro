---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import PressCycle from "../components/PressCycle.astro";
import PressGrid from "../components/PressGrid.astro";
import BioTeaser from "../components/BioTeaser.astro";
import FullBleedImage from "../components/FullBleedImage.astro";
import NextConcerts from "../components/NextConcerts.astro";
import MediaGrid from "../components/MediaGrid.astro";
import PhotoTicker from "../components/PhotoTicker.astro";
import data from "../data/home.json";
import upcoming from "../data/concerts-upcoming.json";
import type { Concert } from "../lib/concert";

const concerts = (upcoming as Concert[]).slice(0, 6);
---

<Layout title="Kiron Atom Tellian — Pianist · Composer">
  <Hero
    title={data.hero.title}
    subtitle={data.hero.subtitle}
    image={data.hero.image}
    imageAlt={data.hero.imageAlt}
  />

  <PressCycle quotes={data.pressCycle} />

  <BioTeaser paragraphs={data.bio} />

  <FullBleedImage src={data.secondaryImage.src} alt={data.secondaryImage.alt} height="65vh" position="38% 25%" />

  <PressGrid quotes={data.pressGrid} />

  <NextConcerts concerts={concerts} intro={data.calendarQuote} />

  <FullBleedImage src={data.tertiaryImage.src} alt={data.tertiaryImage.alt} height="65vh" position="22% 27%" />

  <MediaGrid items={data.media} />

  <PhotoTicker photos={data.gallery} credit={data.photoCredit} />
</Layout>
