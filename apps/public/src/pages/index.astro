---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import NextBand from "../components/NextBand.astro";
import SeasonBoard from "../components/SeasonBoard.astro";
import PressFeature from "../components/PressFeature.astro";
import BioTeaser from "../components/BioTeaser.astro";
import MediaGrid from "../components/MediaGrid.astro";
import PhotoTicker from "../components/PhotoTicker.astro";
import data from "../data/home.json";
import { upcomingConcerts } from "../lib/season";

const next = upcomingConcerts[0];
const board = upcomingConcerts.slice(1, 11);
---

<Layout title="Kiron Atom Tellian — Pianist · Composer">
  <Hero
    title={data.hero.title}
    subtitle={data.hero.subtitle}
    image={data.hero.image}
    imageAlt={data.hero.imageAlt}
  />

  <NextBand concert={next} />

  <SeasonBoard
    concerts={board}
    total={upcomingConcerts.length}
    title="Season <em>26/27</em>"
    intro={data.seasonIntro}
  />

  <PressFeature lead={data.pressFeature.lead} others={data.pressFeature.others} />

  <MediaGrid items={data.media} />

  <BioTeaser paragraphs={data.bio} />

  <PhotoTicker photos={data.gallery} credit={data.photoCredit} />
</Layout>
