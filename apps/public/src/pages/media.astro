---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/url";
import mediaData from "../data/media.json";

const items = mediaData.items;

const kind = (url: string | null, yt: string | null) => {
  if (yt || url?.includes("youtu")) return "Video";
  if (url?.includes("oe1.orf")) return "Radio";
  if (url?.includes("orf") || url?.includes("instagram")) return "Interview";
  return "Article";
};
const thumb = (t: string | null) => (t?.startsWith("/") ? withBase(t) : t);
---

<Layout title="Media · Kiron Atom Tellian">
  <PageHero title="Audio &" italic="Video" eyebrow="Media" image="/img/media-hero.jpg" imageAlt="" imagePosition="50% 40%" />

  <section class="media container">
    <ul class="media__grid">
      {items.map((m, i) => {
        const k = kind(m.url, m.youtubeId);
        return (
          <li class="media__item" data-fade style={`transition-delay: ${(i % 3) * 90}ms`}>
            <a class="media__link" href={m.url ?? "#"} target="_blank" rel="noopener noreferrer" data-cursor={k === "Video" ? "Play" : "Open"}>
              {thumb(m.thumbnail) ? (
                <span class="media__frame" data-tilt>
                  <img src={thumb(m.thumbnail)} alt="" loading={i < 3 ? "eager" : "lazy"} decoding="async" />
                  {k === "Video" && (
                    <span class="media__play" aria-hidden="true">
                      <svg width="22" height="24" viewBox="0 0 26 30"><path d="M3 2 L24 15 L3 28 Z" fill="currentColor" /></svg>
                    </span>
                  )}
                </span>
              ) : (
                <span class="media__frame media__frame--text">{m.title.includes("Harrison") ? "HarrisonParrott" : m.title}</span>
              )}
              <span class="mono media__kind">{k}</span>
              <span class="media__title">{m.title}</span>
            </a>
            {m.description && <p class="media__desc">{m.description}</p>}
            {m.details && (
              <details class="media__details">
                <summary class="mono">Programme</summary>
                <p>{m.details}</p>
              </details>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</Layout>

<style>
  .media {
    padding-block: var(--space-24) var(--section-y);
  }

  .media__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-16) var(--space-8);
  }

  .media__link {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .media__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #1a1a1a;
  }

  .media__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out-expo);
  }

  /* One play button for every video, over a light veil that quiets any
     button already printed on the thumbnail. */
  .media__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(11, 11, 11, 0.28);
    color: var(--black);
    transition: background 400ms var(--ease-out-expo);
  }

  .media__play svg {
    box-sizing: content-box;
    padding: 1.25rem 1.125rem 1.25rem 1.375rem;
    border-radius: 50%;
    background: var(--vermilion);
    transition: transform 500ms var(--ease-out-expo);
  }

  .media__link:hover .media__play {
    background: rgba(11, 11, 11, 0.1);
  }

  .media__link:hover .media__play svg {
    transform: scale(1.12);
  }

  .media__frame--text {
    display: flex;
    align-items: flex-end;
    padding: var(--space-6);
    background: var(--vermilion);
    color: var(--black);
    font-family: var(--display);
    font-size: 2.125rem;
    line-height: 1;
  }

  .media__kind {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .media__title {
    font-family: var(--display);
    font-size: 1.625rem;
    line-height: 1.1;
    transition: color 200ms;
  }

  .media__link:hover .media__title {
    color: var(--vermilion);
  }

  .media__desc {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .media__details {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .media__details summary {
    cursor: pointer;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--vermilion);
  }

  .media__details p {
    margin: 0.5rem 0 0;
    white-space: pre-line;
  }

  @media (max-width: 1000px) {
    .media__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .media__grid { grid-template-columns: 1fr; }
  }
</style>
