---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/url";
import data from "../data/about.json";

type Block =
  | { kind: "para"; body: string }
  | { kind: "quote"; publication: string; quote: string; date: string };

const blocks = data.blocks as Block[];
---

<Layout title="Biography · Kiron Atom Tellian" bodyClass="page-about">
  <PageHero
    eyebrow={data.hero.title}
    title={data.hero.eyebrow}
    name
    image={data.hero.image}
    imageAlt={data.hero.imageAlt}
  />

  <article class="bio container">
    <aside class="bio__aside" data-fade>
      <p class="mono bio__role">Pianist / Composer</p>
      {data.intro && (
        <figure class="bio__intro">
          <blockquote>“{data.intro.quote}”</blockquote>
          <figcaption class="mono">{data.intro.publication} · {data.intro.date}</figcaption>
        </figure>
      )}
      {data.download?.file && (
        <a class="bio__dl" href={withBase(data.download.file)} download>
          <span class="mono bio__dl-note">{data.download.note}</span>
          <span class="bio__dl-label">{data.download.label}</span>
          <span class="bio__dl-icon" aria-hidden="true">↓</span>
        </a>
      )}
      <a class="link-line bio__kit" href={withBase("/presenters")}>Short versions for presenters →</a>
    </aside>

    <div class="bio__body">
      {blocks.map((b) =>
        b.kind === "para" ? (
          <p class="bio__p" data-fade>{b.body}</p>
        ) : (
          <figure class="bio__quote">
            <blockquote data-split>“{b.quote}”</blockquote>
            <figcaption class="mono" data-fade>{b.publication} · {b.date}</figcaption>
          </figure>
        ),
      )}
      <a class="link-line bio__more" href={withBase("/press")}>Read all press →</a>
    </div>
  </article>
</Layout>

<style>
  .bio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: var(--space-24) var(--section-y);
  }

  .bio__aside {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-8));
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .bio__role {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .bio__intro {
    margin: 0;
    padding-block: var(--space-6);
    border-block: 1px solid var(--rule);
  }

  .bio__intro blockquote {
    margin: 0 0 var(--space-3);
    font-family: var(--display);
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .bio__intro figcaption,
  .bio__quote figcaption {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Download card: stays in view beside the text while reading. */
  .bio__dl {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
    align-items: end;
    width: 100%;
    padding: 1.5rem;
    background: var(--bone);
    color: var(--black);
    overflow: hidden;
    isolation: isolate;
  }

  .bio__dl::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--vermilion);
    transform: translateY(101%);
    transition: transform 500ms var(--ease-out-expo);
  }

  .bio__dl:hover::before,
  .bio__dl:focus-visible::before {
    transform: none;
  }

  .bio__dl-note {
    grid-column: 1 / -1;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone-muted);
    transition: color 300ms;
  }

  .bio__dl:hover .bio__dl-note {
    color: var(--black);
  }

  .bio__dl-label {
    font-family: var(--display);
    font-size: 2rem;
    line-height: 1;
  }

  .bio__dl-icon {
    font-size: 1.75rem;
    line-height: 1;
    transition: transform 500ms var(--ease-out-expo);
  }

  .bio__dl:hover .bio__dl-icon {
    transform: translateY(4px);
  }

  .bio__kit {
    font-size: 0.8125rem;
  }

  .bio__body {
    max-width: 52rem;
  }

  .bio__p {
    margin: 0 0 1.75rem;
    font-size: 1.25rem;
    line-height: 1.65;
    color: #d6d1c7;
  }

  .bio__p:first-child::first-letter {
    float: left;
    margin: 0.1em 0.12em 0 0;
    font-family: var(--display);
    font-size: 5.2em;
    line-height: 0.8;
    color: var(--vermilion);
  }

  .bio__quote {
    margin: var(--space-12) 0;
    padding-block: var(--space-12);
    border-block: 1px solid var(--rule);
  }

  .bio__quote blockquote {
    margin: 0 0 var(--space-4);
    font-family: var(--display);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    line-height: 1.08;
  }

  .bio__more {
    margin-top: var(--space-8);
  }

  @media (max-width: 900px) {
    .bio { grid-template-columns: 1fr; }
    .bio__aside { position: static; }
  }
</style>
