---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { withBase } from "../lib/url";
import data from "../data/about.json";

type Block =
  | { kind: "para"; body: string }
  | { kind: "quote"; publication: string; quote: string; date: string };

const blocks = data.blocks as Block[];
const [first, ...restTitle] = data.hero.eyebrow.split(" ").reverse();
---

<Layout title="Biography · Kiron Atom Tellian" bodyClass="page-about">
  <PageHero
    eyebrow={data.hero.title}
    title={restTitle.reverse().join(" ")}
    italic={first}
    image={data.hero.image}
    imageAlt={data.hero.imageAlt}
  />

  <article class="bio container">
    <aside class="bio__aside" data-fade>
      <p class="mono bio__role">Pianist / Composer</p>
      {data.intro && (
        <figure class="bio__intro">
          <blockquote>“{data.intro.quote}”</blockquote>
          <figcaption class="mono">{data.intro.publication} · {data.intro.date}</figcaption>
        </figure>
      )}
      <a class="pill" href={withBase("/presenters")}>Short biographies for presenters →</a>
    </aside>

    <div class="bio__body">
      {blocks.map((b) =>
        b.kind === "para" ? (
          <p class="bio__p" data-fade>{b.body}</p>
        ) : (
          <figure class="bio__quote">
            <blockquote data-split>“{b.quote}”</blockquote>
            <figcaption class="mono" data-fade>{b.publication} · {b.date}</figcaption>
          </figure>
        ),
      )}
      <a class="link-line bio__more" href={withBase("/press")}>Read all press →</a>
    </div>
  </article>
</Layout>

<style>
  .bio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: var(--space-24) var(--section-y);
  }

  .bio__aside {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-8));
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  .bio__role {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .bio__intro {
    margin: 0;
    padding-block: var(--space-6);
    border-block: 1px solid var(--rule);
  }

  .bio__intro blockquote {
    margin: 0 0 var(--space-3);
    font-family: var(--display);
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .bio__intro figcaption,
  .bio__quote figcaption {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .bio__body {
    max-width: 52rem;
  }

  .bio__p {
    margin: 0 0 1.75rem;
    font-size: 1.25rem;
    line-height: 1.65;
    color: #d6d1c7;
  }

  .bio__p:first-child::first-letter {
    float: left;
    margin: 0.1em 0.12em 0 0;
    font-family: var(--display);
    font-size: 5.2em;
    line-height: 0.8;
    color: var(--vermilion);
  }

  .bio__quote {
    margin: var(--space-12) 0;
    padding-block: var(--space-12);
    border-block: 1px solid var(--rule);
  }

  .bio__quote blockquote {
    margin: 0 0 var(--space-4);
    font-family: var(--display);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    line-height: 1.08;
  }

  .bio__more {
    margin-top: var(--space-8);
  }

  @media (max-width: 900px) {
    .bio { grid-template-columns: 1fr; }
    .bio__aside { position: static; }
  }
</style>
