---
import { withBase } from "../lib/url";

export interface Props {
  title: string;
  image?: string;
  imageAlt?: string;
  eyebrow?: string;
  light?: boolean;
  imagePosition?: string;
}
const { title, image, imageAlt = "", eyebrow, light = false, imagePosition = "center 30%" } = Astro.props;
const hasImage = Boolean(image);
---

<header class={`page-hero ${hasImage ? "page-hero--media" : "page-hero--plain"} ${light ? "page-hero--light" : ""}`}>
  {hasImage && (
    <div class="page-hero__media">
      <img
        class="page-hero__img"
        src={withBase(image!)}
        alt={imageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={`object-position: ${imagePosition};`}
      />
      <div class="page-hero__veil" aria-hidden="true"></div>
    </div>
  )}
  <div class="container page-hero__content">
    {eyebrow && <p class="eyebrow accent page-hero__eyebrow">{eyebrow}</p>}
    <h1 class="display-l-italic page-hero__title">{title}</h1>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    padding-top: calc(var(--nav-offset) + var(--space-12));
    padding-bottom: var(--space-12);
    overflow: hidden;
  }

  .page-hero--media {
    min-height: clamp(36rem, 85svh, 56rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--ink-light);
    background: var(--paper-deep);
    padding-bottom: var(--space-16);
  }


  .page-hero--plain {
    background: var(--paper);
    color: var(--ink);
    text-align: center;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero__veil {
    position: absolute;
    inset: 0;
    /* Only the nav-height stripe is solid (kills the seam). Rest of
       the photo is shown raw — no gradient. */
    background: var(--paper-deep);
    clip-path: inset(0 0 calc(100% - var(--nav-offset)) 0);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
  }

  .page-hero__eyebrow {
    margin-bottom: var(--space-3);
    opacity: 0;
    transform: translateY(8px);
    animation: page-hero-rise 700ms var(--ease-out-expo) 150ms forwards;
  }

  /* Without a gradient veil, the title + eyebrow rely on a soft
     text-shadow to stay readable over any photo. */
  .page-hero--media .page-hero__eyebrow {
    color: var(--ink-light);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.7);
  }

  .page-hero--media .page-hero__title {
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.75);
  }

  .page-hero__title {
    margin: 0;
    color: inherit;
    max-width: 18ch;
    opacity: 0;
    transform: translateY(20px);
    animation: page-hero-rise 900ms var(--ease-out-expo) 300ms forwards;
  }

  .page-hero--plain .page-hero__title {
    margin-inline: auto;
  }

  @keyframes page-hero-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__eyebrow,
    .page-hero__title { animation: none; opacity: 1; transform: none; }
  }
</style>
