---
import { withBase } from "../lib/url";

export interface Props {
  title: string;
  /** Last word(s) set in italic, as in "Audio & <em>Video</em>". */
  italic?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  eyebrow?: string;
  /** Right-hand note on plain heroes, e.g. a photo credit. */
  aside?: string;
}
const { title, italic, image, imageAlt = "", imagePosition = "50% 30%", eyebrow, aside } = Astro.props;
const words = [...title.split(/\s+/).filter(Boolean).map((w) => ({ w, it: false })), ...(italic ? italic.split(/\s+/).map((w) => ({ w, it: true })) : [])];
---

<header class={`page-hero ${image ? "page-hero--media" : "page-hero--plain"}`}>
  {image && (
    <div class="page-hero__media" data-parallax="0.2">
      <img class="page-hero__img" src={withBase(image)} alt={imageAlt} style={`object-position: ${imagePosition}`} loading="eager" fetchpriority="high" decoding="async" />
    </div>
  )}
  {image && <div class="page-hero__veil" aria-hidden="true"></div>}
  <div class="container page-hero__content">
    <div>
      {eyebrow && <p class="mono page-hero__eyebrow">{eyebrow}</p>}
      <h1 class="page-hero__title">
        {words.map(({ w, it }, i) => (
          <>
            <span class="page-hero__w"><span style={`--i: ${i}`} class={it ? "page-hero__it" : ""}>{w}</span></span>{" "}
          </>
        ))}
      </h1>
    </div>
    {aside && <p class="mono page-hero__aside" set:html={aside} />}
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
  }

  .page-hero--media {
    min-height: clamp(26rem, 70svh, 45rem);
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-12);
  }

  .page-hero--plain {
    padding: calc(var(--nav-h) + var(--space-24)) 0 var(--space-12);
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    animation: page-hero-zoom 1800ms var(--ease-out-expo) both;
  }

  .page-hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 11, 11, 0.6) 0%, rgba(11, 11, 11, 0.1) 30%, rgba(11, 11, 11, 0.25) 60%, rgba(11, 11, 11, 0.95) 100%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .page-hero__eyebrow {
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vermilion);
    animation: page-hero-fade 800ms var(--ease-out-expo) 200ms both;
  }

  .page-hero__title {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(4rem, 10vw, 10rem);
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  /* Each word rises out of its own mask on load. */
  .page-hero__w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .page-hero__w > span {
    display: inline-block;
    animation: page-hero-rise 1100ms var(--ease-out-expo) both;
    animation-delay: calc(250ms + var(--i) * 90ms);
  }

  .page-hero__it {
    font-style: italic;
  }

  .page-hero__aside {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    animation: page-hero-fade 800ms var(--ease-out-expo) 700ms both;
  }

  .page-hero__aside :global(a) {
    border-bottom: 1px solid var(--vermilion);
  }

  @keyframes page-hero-rise {
    from { transform: translateY(105%); }
  }

  @keyframes page-hero-fade {
    from { opacity: 0; transform: translateY(12px); }
  }

  @keyframes page-hero-zoom {
    from { transform: scale(1.12); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__img,
    .page-hero__eyebrow,
    .page-hero__aside,
    .page-hero__w > span { animation: none; }
  }
</style>
