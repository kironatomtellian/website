---
import { withBase } from "../lib/url";

export interface MediaItem {
  title: string;
  description: string;
  youtubeId: string | null;
  thumbnail: string;
  url: string;
  source: string;
}
export interface Props {
  items: MediaItem[];
}
const { items } = Astro.props;
---

<section class="media-grid section" aria-label="Audio and video">
  <div class="container">
    <header class="media-grid__header reveal">
      <p class="eyebrow accent">Selected Recordings</p>
      <h2 class="display-l-italic media-grid__title">Audio &amp; Video</h2>
    </header>

    <div class="media-grid__items reveal-stagger">
      {items.map((m) => (
        <a
          class="media-card"
          href={m.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Open ${m.title} in new tab`}
          data-yt-id={m.youtubeId ?? ""}
        >
          <div class="media-card__frame">
            <img
              class="media-card__img"
              src={withBase(m.thumbnail)}
              alt=""
              loading="lazy"
              decoding="async"
              width="1280"
              height="720"
            />
            <div class="media-card__overlay" aria-hidden="true">
              <svg viewBox="0 0 64 64" width="44" height="44" fill="none" aria-hidden="true">
                <circle cx="32" cy="32" r="31" stroke="currentColor" stroke-width="1" />
                <path d="M26 22 L44 32 L26 42 Z" fill="currentColor" />
              </svg>
            </div>
          </div>
          <h3 class="h3 media-card__title">{m.title}</h3>
          <p class="small muted media-card__desc">{m.description}</p>
        </a>
      ))}
    </div>

    <p class="media-grid__cta reveal">
      <a class="link-quiet" href={withBase("/media")}>
        All recordings <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .media-grid__header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .media-grid__title {
    margin-top: var(--space-3);
  }

  .media-grid__items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-12) var(--space-8);
    max-width: 1100px;
    margin-inline: auto;
  }

  .media-card {
    display: block;
    color: var(--ink);
  }

  .media-card__frame {
    position: relative;
    overflow: hidden;
    background: var(--paper-deep);
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-4);
  }

  .media-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out-expo),
                opacity var(--t-hover) var(--ease-standard);
  }

  .media-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-light);
    background: linear-gradient(
      to bottom,
      rgba(14, 12, 10, 0) 50%,
      rgba(14, 12, 10, 0.35) 100%
    );
    opacity: 0;
    transition: opacity var(--t-hover) var(--ease-standard);
  }

  .media-card:hover .media-card__overlay,
  .media-card:focus-visible .media-card__overlay {
    opacity: 1;
  }

  .media-card:hover .media-card__img,
  .media-card:focus-visible .media-card__img {
    transform: scale(1.03);
  }

  .media-card__title {
    margin: 0 0 var(--space-2);
    font-style: italic;
    font-weight: 400;
    transition: color var(--t-hover) var(--ease-standard);
  }

  .media-card:hover .media-card__title {
    color: var(--accent);
  }

  .media-card__desc {
    margin: 0;
  }

  .media-grid__cta {
    text-align: center;
    margin-top: var(--space-16);
  }

  @media (max-width: 768px) {
    .media-grid__items {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>

<script>
  /* YouTube storyboard hover preview.
     For each card with [data-yt-id], on hover cycle through the YouTube
     thumbnail frames (1.jpg, 2.jpg, 3.jpg) which YouTube serves as
     three timeline samples. Lighter than an iframe embed: zero JS cost,
     no cookies, no third-party connection until click. */
  const cards = document.querySelectorAll<HTMLAnchorElement>(".media-card[data-yt-id]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isTouch = window.matchMedia("(hover: none)").matches;

  if (!reduceMotion && !isTouch) {
    cards.forEach((card) => {
      const ytId = card.getAttribute("data-yt-id");
      if (!ytId) return;
      const img = card.querySelector<HTMLImageElement>(".media-card__img");
      if (!img) return;
      const original = img.src;
      const frames = [
        `https://i.ytimg.com/vi/${ytId}/1.jpg`,
        `https://i.ytimg.com/vi/${ytId}/2.jpg`,
        `https://i.ytimg.com/vi/${ytId}/3.jpg`,
      ];
      frames.forEach((src) => { const i = new Image(); i.src = src; });

      let timer: number | null = null;
      let i = 0;

      card.addEventListener("mouseenter", () => {
        if (timer !== null) return;
        timer = window.setInterval(() => {
          i = (i + 1) % frames.length;
          img.src = frames[i] ?? original;
        }, 700);
      });

      card.addEventListener("mouseleave", () => {
        if (timer !== null) window.clearInterval(timer);
        timer = null;
        i = 0;
        img.src = original;
      });
    });
  }
</script>
