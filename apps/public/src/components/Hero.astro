---
import { withBase } from "../lib/url";

export interface Props {
  title: string;
  subtitle: string;
  image: string;
  imageAlt: string;
}
const { title, subtitle, image, imageAlt } = Astro.props;

// The name is centred, as on the live site; the last word is set in italic.
const words = title.trim().split(/\s+/);
const last = words.pop() ?? "";
const first = words.join(" ");
---

<section class="hero" aria-label="Introduction">
  <img
    class="hero__img"
    src={withBase(image)}
    alt={imageAlt}
    width="2560"
    height="1707"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__content">
    <h1 class="display-xxl hero__title">
      {first && <span class="hero__line">{first}</span>}{" "}
      <span class="hero__line hero__line--last">{last}</span>
    </h1>
    <p class="mono hero__subtitle">{subtitle}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 980px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--black);
    color: var(--bone);
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Wide screens crop the sides, never the face. */
    object-position: 50% 28%;
    filter: grayscale(1) contrast(1.08);
    transform: scale(1.04);
    animation: hero-zoom 1600ms var(--ease-out-expo) 50ms forwards;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(11, 11, 11, 0.55) 0%,
      rgba(11, 11, 11, 0) 22%,
      rgba(11, 11, 11, 0) 52%,
      rgba(11, 11, 11, 0.92) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding-bottom: var(--space-12);
    text-align: center;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(3.5rem, 11vw, 11.25rem);
  }

  .hero__line {
    display: inline-block;
    opacity: 0;
    transform: translateY(32px);
    animation: hero-rise 900ms var(--ease-out-expo) 200ms forwards;
  }

  .hero__line--last {
    font-style: italic;
    animation-delay: 360ms;
  }

  .hero__subtitle {
    margin: 0;
    color: #c9c3b8;
    letter-spacing: 0.12em;
    opacity: 0;
    animation: hero-rise 700ms var(--ease-out-expo) 700ms forwards;
  }

  @keyframes hero-zoom {
    to { transform: scale(1); }
  }

  @keyframes hero-rise {
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .hero { min-height: 82svh; }
    .hero__img { object-position: 50% 20%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img { animation: none; transform: none; }
    .hero__line,
    .hero__subtitle { animation: none; opacity: 1; transform: none; }
  }
</style>
