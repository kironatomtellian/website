---
export interface Props {
  publication: string;
  quote: string;
  date: string;
  url?: string | null;
  byline?: string | null;
  align?: "left" | "center";
}
const { publication, quote, date, url, byline, align = "center" } = Astro.props;
---

<figure class={`pq pq--${align} reveal`}>
  <p class="eyebrow accent pq__pub">
    {url ? <a href={url} target="_blank" rel="noopener">{publication}</a> : publication}
    {byline && <span class="pq__byline muted"> · {byline}</span>}
  </p>
  <blockquote class="pull-quote pq__text">
    <span class="pq__mark" aria-hidden="true">»</span>
    <span class="pq__inner" set:html={quote} />
    <span class="pq__mark pq__mark--end" aria-hidden="true">«</span>
  </blockquote>
  <figcaption class="small muted pq__date italic">{date}</figcaption>
</figure>

<style>
  .pq {
    margin: 0;
    padding-block: var(--space-8);
    max-width: 56ch;
  }

  .pq--center {
    margin-inline: auto;
    text-align: center;
  }

  .pq__pub {
    margin-bottom: var(--space-2);
    display: inline-block;
  }

  .pq__pub a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--t-hover) var(--ease-standard),
                color var(--t-hover) var(--ease-standard);
  }

  .pq__pub a:hover {
    text-decoration-color: var(--accent);
    color: var(--accent);
  }

  .bg-deep .pq__pub a:hover {
    text-decoration-color: var(--accent-soft);
    color: var(--accent-soft);
  }

  .pq__byline {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-style: italic;
  }

  .pq__text {
    margin: 0 0 var(--space-3);
  }

  .pq__mark {
    color: var(--accent-soft);
    font-style: italic;
    font-size: 1.15em;
    line-height: 1;
    vertical-align: -0.05em;
    margin-right: 0.12em;
  }

  .pq__mark--end {
    margin-right: 0;
    margin-left: 0.12em;
  }

  .pq__inner :global(strong) {
    color: var(--accent);
    font-weight: 400;
    font-style: italic;
  }

  .bg-deep .pq__inner :global(strong) {
    color: var(--accent-soft);
  }
</style>
