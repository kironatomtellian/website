---
export interface Props {
  publication: string;
  quote: string;
  date: string;
  url?: string | null;
  byline?: string | null;
  align?: "left" | "center";
}
const { publication, quote, date, url, byline, align = "center" } = Astro.props;

const stripTags = (s: string) => s.replace(/<[^>]+>/g, "");

function extractHighlight(raw: string): string {
  const m = raw.match(/<strong>([\s\S]*?)<\/strong>/i);
  if (m && m[1]) return stripTags(m[1]).trim();
  const plain = stripTags(raw).trim();
  const sentence = plain.match(/^[^.!?…]+[.!?…]/);
  if (sentence) return sentence[0].trim();
  return plain.length > 160 ? plain.slice(0, 160).trim() + "…" : plain;
}

const highlight = extractHighlight(quote);
const fullPlain = stripTags(quote).trim();
const hasFullBody = fullPlain.length > highlight.length + 8;
---

<figure class={`pq pq--${align} reveal`}>
  <p class="eyebrow accent pq__pub">
    {url ? <a href={url} target="_blank" rel="noopener">{publication}</a> : publication}
    {byline && <span class="pq__byline muted"> · {byline}</span>}
  </p>
  <blockquote class="pull-quote pull-quote--lg pq__highlight">
    <span class="pq__mark" aria-hidden="true">»</span>
    <span class="pq__inner">{highlight}</span>
    <span class="pq__mark pq__mark--end" aria-hidden="true">«</span>
  </blockquote>
  {hasFullBody && (
    <p class="small pq__full" set:html={quote} />
  )}
  <figcaption class="small muted pq__date italic">{date}</figcaption>
</figure>

<style>
  .pq {
    margin: 0;
    padding-block: var(--space-6);
    max-width: 62ch;
  }

  .pq--center {
    margin-inline: auto;
    text-align: center;
  }

  .pq__pub {
    margin-bottom: var(--space-2);
    display: inline-block;
  }

  .pq__pub a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--t-hover) var(--ease-standard),
                color var(--t-hover) var(--ease-standard);
  }

  .pq__pub a:hover {
    text-decoration-color: var(--accent);
    color: var(--accent);
  }

  .bg-deep .pq__pub a:hover {
    text-decoration-color: var(--accent-soft);
    color: var(--accent-soft);
  }

  .pq__byline {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-style: italic;
  }

  .pq__highlight {
    margin: 0 0 var(--space-3);
  }

  .pq__full {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 60ch;
  }

  .pq--center .pq__full {
    margin-inline: auto;
  }

  .bg-deep .pq__full {
    color: var(--muted-light);
  }

  .pq__full :global(strong) {
    color: var(--ink);
    font-weight: 400;
  }

  .bg-deep .pq__full :global(strong) {
    color: var(--ink-light);
  }

  .pq__mark {
    color: var(--accent-soft);
    font-style: italic;
    font-size: 1.05em;
    line-height: 1;
    vertical-align: -0.05em;
    margin-right: 0.1em;
  }

  .pq__mark--end {
    margin-right: 0;
    margin-left: 0.1em;
  }

  .pq__inner :global(strong) {
    color: var(--accent);
    font-weight: 400;
    font-style: italic;
  }

  .bg-deep .pq__inner :global(strong) {
    color: var(--accent-soft);
  }
</style>
