---
import { withBase } from "../lib/url";
import { upcomingConcerts } from "../lib/season";
import { cityOf } from "../lib/concert";

const items = [
  { href: "/schedule", label: "Schedule" },
  { href: "/about", label: "Biography" },
  { href: "/press", label: "Press" },
  { href: "/schedule-archive", label: "Past Concerts" },
  { href: "/media", label: "Media" },
  { href: "/gallery", label: "Gallery" },
  { href: "/contact", label: "Contact" },
];

const next = upcomingConcerts[0];
const nextLabel = next
  ? `Next · ${new Date(next.date).toLocaleString("en", { month: "short", day: "numeric", timeZone: "UTC" })} · ${cityOf(next)}`
  : null;
---

<nav class="site-nav" data-nav>
  <div class="site-nav__inner container">
    <a class="site-nav__brand" href={withBase("/")} aria-label="Kiron Atom Tellian, home">Kiron Atom <em>Tellian</em></a>
    <button
      class="site-nav__toggle"
      type="button"
      aria-controls="site-nav-list"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="site-nav__toggle-bar"></span>
      <span class="site-nav__toggle-bar"></span>
    </button>
    <ul id="site-nav-list" class="site-nav__list">
      {items.map((item) => (
        <li>
          <a
            class="site-nav__link"
            href={withBase(item.href)}
            aria-current={
              Astro.url.pathname === withBase(item.href) ||
              (item.href !== "/" && Astro.url.pathname.startsWith(withBase(item.href) + "/"))
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    {nextLabel && (
      <a class="site-nav__next mono" href={withBase("/schedule")}>
        <span class="site-nav__dot" aria-hidden="true"></span>{nextLabel}
      </a>
    )}
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: color-mix(in oklab, var(--paper-deep) 30%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    backdrop-filter: blur(12px) saturate(120%);
    color: var(--ink-light);
    transition: background var(--t-hover) var(--ease-standard),
                border-color var(--t-hover) var(--ease-standard);
    border-bottom: 1px solid transparent;
  }

  :global(body.bg-bone) .site-nav {
    background: var(--black);
  }

  .site-nav.is-scrolled {
    background: var(--paper-deep);
    border-bottom-color: var(--rule-dark);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    transition: height var(--t-hover) var(--ease-standard);
  }

  .site-nav.is-scrolled .site-nav__inner {
    height: var(--nav-h-scrolled);
  }

  .site-nav__next {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid rgba(239, 235, 227, 0.35);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--ink-light);
  }

  .site-nav__next:hover {
    border-color: var(--accent);
  }

  .site-nav__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vermilion);
  }

  .site-nav__brand {
    font-family: var(--display);
    font-size: clamp(1.25rem, 1.8vw, 1.625rem);
    white-space: nowrap;
    margin-right: var(--space-8);
    letter-spacing: -0.01em;
    color: var(--ink-light);
    line-height: 1;
    transition: color var(--t-hover) var(--ease-standard);
  }

  .site-nav__brand:hover {
    color: var(--accent-soft);
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    align-items: center;
  }

  .site-nav__link {
    position: relative;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-light);
    padding-block: 0.5rem;
    transition: color var(--t-hover) var(--ease-standard);
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: var(--accent-soft);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-hover) var(--ease-out-expo);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current="page"] {
    color: var(--accent-soft);
  }

  .site-nav__toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    position: relative;
  }

  .site-nav__toggle-bar {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    height: 1px;
    background: var(--ink-light);
    transition: transform 250ms var(--ease-out-expo),
                opacity 200ms var(--ease-standard);
  }

  .site-nav__toggle-bar:nth-child(2) { top: calc(50% - 4px); }
  .site-nav__toggle-bar:nth-child(3) { top: calc(50% + 4px); }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(2) {
    top: 50%;
    transform: rotate(45deg);
  }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(3) {
    top: 50%;
    transform: rotate(-45deg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 1024px) {
    .site-nav__next { display: none; }
  }

  @media (max-width: 768px) {
    .site-nav__toggle { display: block; }

    .site-nav__list {
      position: fixed;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      background: var(--paper-deep);
      padding: var(--space-8) var(--gutter);
      gap: var(--space-4);
      transform: translateY(calc(-100% - var(--nav-h)));
      visibility: hidden;
      transition: transform 350ms var(--ease-out-expo), visibility 0s linear 350ms;
      border-bottom: 1px solid var(--rule-dark);
    }

    .site-nav[data-open="true"] .site-nav__list {
      transform: translateY(0);
      visibility: visible;
      transition: transform 350ms var(--ease-out-expo), visibility 0s;
    }

    .site-nav__link {
      font-family: var(--display);
      font-size: 2rem;
      letter-spacing: 0;
      text-transform: none;
    }
  }
  /* The full name plus seven items leave no room for the pill on mid-size screens. */
  @media (max-width: 1280px) {
    .site-nav__next { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");

  if (nav && toggle) {
    toggle.addEventListener("click", () => {
      const open = nav.getAttribute("data-open") === "true";
      nav.setAttribute("data-open", open ? "false" : "true");
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
    });

    nav.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        nav.setAttribute("data-open", "false");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 80) {
      nav.classList.add("is-scrolled");
    } else {
      nav.classList.remove("is-scrolled");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
