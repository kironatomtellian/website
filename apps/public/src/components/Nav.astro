---
import { withBase } from "../lib/url";

const items = [
  { href: "/about", label: "Biography" },
  { href: "/press", label: "Press" },
  { href: "/schedule", label: "Schedule" },
  { href: "/schedule-archive", label: "Past Concerts" },
  { href: "/media", label: "Media" },
  { href: "/gallery", label: "Gallery" },
];
---

<nav class="site-nav" data-nav>
  <div class="site-nav__inner container">
    <a class="site-nav__brand" href={withBase("/")}>Kiron Atom Tellian</a>
    <button
      class="site-nav__toggle"
      type="button"
      aria-controls="site-nav-list"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="site-nav__toggle-bar"></span>
      <span class="site-nav__toggle-bar"></span>
    </button>
    <ul id="site-nav-list" class="site-nav__list">
      {items.map((item) => (
        <li>
          <a
            class="site-nav__link"
            href={withBase(item.href)}
            aria-current={
              Astro.url.pathname === withBase(item.href) ||
              (item.href !== "/" &&
                Astro.url.pathname.startsWith(withBase(item.href) + "/"))
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: var(--paper-deep);
    color: var(--ink-light);
    padding-top: env(safe-area-inset-top, 0px);
  }

  .site-nav__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    line-height: 1;
    transition: height var(--t-hover) var(--ease-standard);
  }

  .site-nav.is-scrolled .site-nav__inner {
    height: var(--nav-h-scrolled);
  }

  .site-nav__brand {
    font-style: normal;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    letter-spacing: -0.01em;
    color: var(--ink-light);
    line-height: 1;
    display: inline-block;
    /* Caslon puts its cap-to-baseline zone in the upper portion of the
       line-box, so labels without descenders sit visibly above center.
       Asymmetric padding nudges the visible glyph block down. */
    padding-top: 0.22em;
    padding-bottom: 0;
    transition: color var(--t-hover) var(--ease-standard);
  }

  .site-nav__brand:hover {
    color: var(--accent-soft);
  }

  .site-nav__list {
    display: flex;
    gap: clamp(0.875rem, 2vw, 2rem);
    align-items: center;
    line-height: 1;
  }

  .site-nav__link {
    position: relative;
    display: inline-block;
    font-size: 0.9375rem;
    line-height: 1;
    color: var(--ink-light);
    padding-top: 0.65rem;
    padding-bottom: 0.45rem;
    transition: color var(--t-hover) var(--ease-standard);
  }

  @supports (text-box-trim: trim-both) {
    .site-nav__brand,
    .site-nav__link {
      text-box-trim: trim-both;
      text-box-edge: cap alphabetic;
    }
    .site-nav__brand {
      padding-top: 0;
    }
    .site-nav__link {
      padding-top: 0.55rem;
      padding-bottom: 0.55rem;
    }
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--accent-soft);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-hover) var(--ease-out-expo);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current="page"] {
    color: var(--accent-soft);
  }

  .site-nav__toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    position: relative;
  }

  .site-nav__toggle-bar {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    height: 1px;
    background: var(--ink-light);
    transition: transform 250ms var(--ease-out-expo),
                opacity 200ms var(--ease-standard);
  }

  .site-nav__toggle-bar:nth-child(2) { top: calc(50% - 4px); }
  .site-nav__toggle-bar:nth-child(3) { top: calc(50% + 4px); }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(2) {
    top: 50%;
    transform: rotate(45deg);
  }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(3) {
    top: 50%;
    transform: rotate(-45deg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 900px) {
    .site-nav__toggle { display: block; }

    /* Full-screen black overlay anchored to the very top of the
       viewport, sitting BEHIND the nav__inner (z-index: 1 vs 2) so
       the brand and the hamburger-to-X stay tappable on top of the
       overlay — no gap between the nav and the menu. */
    .site-nav__list {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      background: #000;
      padding: calc(var(--nav-offset) + var(--space-10)) var(--gutter) var(--space-12);
      gap: var(--space-6);
      opacity: 0;
      visibility: hidden;
      transition: opacity 300ms var(--ease-standard),
                  visibility 0s linear 300ms;
    }

    .site-nav[data-open="true"] .site-nav__list {
      opacity: 1;
      visibility: visible;
      transition: opacity 300ms var(--ease-standard),
                  visibility 0s linear 0s;
    }

    .site-nav__list li {
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 450ms var(--ease-out-quart),
                  transform 450ms var(--ease-out-quart);
    }

    .site-nav[data-open="true"] .site-nav__list li {
      opacity: 1;
      transform: translateY(0);
    }

    .site-nav[data-open="true"] .site-nav__list li:nth-child(1) { transition-delay: 120ms; }
    .site-nav[data-open="true"] .site-nav__list li:nth-child(2) { transition-delay: 170ms; }
    .site-nav[data-open="true"] .site-nav__list li:nth-child(3) { transition-delay: 220ms; }
    .site-nav[data-open="true"] .site-nav__list li:nth-child(4) { transition-delay: 270ms; }
    .site-nav[data-open="true"] .site-nav__list li:nth-child(5) { transition-delay: 320ms; }
    .site-nav[data-open="true"] .site-nav__list li:nth-child(6) { transition-delay: 370ms; }

    .site-nav__link {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");

  if (nav && toggle) {
    toggle.addEventListener("click", () => {
      const open = nav.getAttribute("data-open") === "true";
      nav.setAttribute("data-open", open ? "false" : "true");
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
    });

    nav.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        nav.setAttribute("data-open", "false");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 80) {
      nav.classList.add("is-scrolled");
    } else {
      nav.classList.remove("is-scrolled");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
