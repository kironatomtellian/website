---
const items = [
  { href: "/about", label: "Biography" },
  { href: "/press", label: "Press" },
  { href: "/schedule", label: "Schedule" },
  { href: "/media", label: "Media" },
  { href: "/gallery", label: "Gallery" },
];
---

<nav class="site-nav" data-nav>
  <div class="site-nav__inner container">
    <a class="site-nav__brand" href="/">Kiron Atom Tellian</a>
    <button
      class="site-nav__toggle"
      type="button"
      aria-controls="site-nav-list"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="site-nav__toggle-bar"></span>
      <span class="site-nav__toggle-bar"></span>
    </button>
    <ul id="site-nav-list" class="site-nav__list">
      {items.map((item) => (
        <li>
          <a
            class="site-nav__link"
            href={item.href}
            aria-current={
              Astro.url.pathname === item.href ||
              (item.href !== "/" && Astro.url.pathname.startsWith(item.href))
                ? "page"
                : undefined
            }
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: color-mix(in oklab, var(--paper-deep) 30%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    backdrop-filter: blur(12px) saturate(120%);
    color: var(--ink-light);
    transition: background var(--t-hover) var(--ease-standard),
                border-color var(--t-hover) var(--ease-standard);
    border-bottom: 1px solid transparent;
  }

  .site-nav.is-scrolled {
    background: var(--paper-deep);
    border-bottom-color: var(--rule-dark);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    transition: height var(--t-hover) var(--ease-standard);
  }

  .site-nav.is-scrolled .site-nav__inner {
    height: var(--nav-h-scrolled);
  }

  .site-nav__brand {
    font-style: italic;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    letter-spacing: -0.01em;
    color: var(--ink-light);
    line-height: 1;
    transition: color var(--t-hover) var(--ease-standard);
  }

  .site-nav__brand:hover {
    color: var(--accent-soft);
  }

  .site-nav__list {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    align-items: center;
  }

  .site-nav__link {
    position: relative;
    font-size: 0.9375rem;
    color: var(--ink-light);
    padding-block: 0.5rem;
    transition: color var(--t-hover) var(--ease-standard);
  }

  .site-nav__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 1px;
    background: var(--accent-soft);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--t-hover) var(--ease-out-expo);
  }

  .site-nav__link:hover::after,
  .site-nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .site-nav__link[aria-current="page"] {
    color: var(--accent-soft);
  }

  .site-nav__toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    position: relative;
  }

  .site-nav__toggle-bar {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    height: 1px;
    background: var(--ink-light);
    transition: transform 250ms var(--ease-out-expo),
                opacity 200ms var(--ease-standard);
  }

  .site-nav__toggle-bar:nth-child(2) { top: calc(50% - 4px); }
  .site-nav__toggle-bar:nth-child(3) { top: calc(50% + 4px); }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(2) {
    top: 50%;
    transform: rotate(45deg);
  }

  .site-nav__toggle[aria-expanded="true"] .site-nav__toggle-bar:nth-child(3) {
    top: 50%;
    transform: rotate(-45deg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 768px) {
    .site-nav__toggle { display: block; }

    .site-nav__list {
      position: fixed;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      background: var(--paper-deep);
      padding: var(--space-8) var(--gutter);
      gap: var(--space-4);
      transform: translateY(-110%);
      transition: transform 350ms var(--ease-out-expo);
      border-bottom: 1px solid var(--rule-dark);
    }

    .site-nav[data-open="true"] .site-nav__list {
      transform: translateY(0);
    }

    .site-nav__link {
      font-size: 1.25rem;
      font-style: italic;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");

  if (nav && toggle) {
    toggle.addEventListener("click", () => {
      const open = nav.getAttribute("data-open") === "true";
      nav.setAttribute("data-open", open ? "false" : "true");
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
    });

    nav.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        nav.setAttribute("data-open", "false");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }

  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 80) {
      nav.classList.add("is-scrolled");
    } else {
      nav.classList.remove("is-scrolled");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
