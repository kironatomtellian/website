---
import { withBase } from "../lib/url";

export interface Props {
  paragraphs: string[];
  image?: string;
}
const { paragraphs, image = "/img/about-hero.jpg" } = Astro.props;
---

<section class="bio-teaser container" id="bio-teaser" aria-labelledby="bio-teaser-h">
  <div class="bio-teaser__media" data-wipe data-tilt>
    <img src={withBase(image)} alt="Kiron Atom Tellian by a factory window" loading="lazy" decoding="async" />
  </div>
  <div class="bio-teaser__text">
    <h2 id="bio-teaser-h" class="bio-teaser__title" data-split>Biography</h2>
    <div data-stagger>
      {paragraphs.map((p) => <p class="bio-teaser__p">{p}</p>)}
      <a class="link-line bio-teaser__cta" href={withBase("/about")}>Read full biography →</a>
    </div>
  </div>
</section>

<style>
  .bio-teaser {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: var(--section-y);
  }

  .bio-teaser__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .bio-teaser__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 30%;
    filter: grayscale(1);
  }

  .bio-teaser__title {
    margin: 0 0 var(--space-8);
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .bio-teaser__p {
    margin: 0 0 var(--space-6);
    max-width: 60ch;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: #d6d1c7;
  }

  .bio-teaser__cta {
    display: inline-block;
    margin-top: var(--space-4);
  }

  @media (max-width: 900px) {
    .bio-teaser { grid-template-columns: 1fr; }
  }
</style>
