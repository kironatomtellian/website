---
export interface Quote {
  publication: string;
  quote: string;
  date: string;
  emphasis?: string;
}
export interface Props {
  lead: Quote;
  others: Quote[];
}
const { lead, others } = Astro.props;

// One word of the lead quote can be set in italic vermilion.
const parts = lead.emphasis ? lead.quote.split(lead.emphasis) : [lead.quote];
---

<section class="press-feature bg-bone" aria-label="Press">
  <div class="container press-feature__inner">
    <p class="mono press-feature__source">{lead.publication} · {lead.date}</p>
    <blockquote class="press-feature__lead">
      “{parts[0]}{lead.emphasis && parts.length > 1 && <em>{lead.emphasis}</em>}{parts.length > 1 && parts[1]}”
    </blockquote>

    <div class="press-feature__grid">
      {others.map((q) => (
        <figure class="press-feature__item">
          <blockquote>“{q.quote}”</blockquote>
          <figcaption>{q.publication} · {q.date}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .press-feature__inner {
    padding-block: var(--section-y);
  }

  .press-feature__source {
    margin: 0 0 var(--space-8);
    color: var(--bone-muted);
  }

  .press-feature__lead {
    max-width: 18ch;
    font-family: var(--display);
    font-size: clamp(2.5rem, 6.2vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .press-feature__lead em {
    color: var(--vermilion-deep);
  }

  .press-feature__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-12);
    margin-top: var(--space-24);
    padding-top: var(--space-12);
    border-top: 1px solid var(--bone-rule);
  }

  .press-feature__item {
    margin: 0;
  }

  .press-feature__item blockquote {
    font-family: var(--display);
    font-size: 1.625rem;
    line-height: 1.2;
  }

  .press-feature__item figcaption {
    margin-top: var(--space-4);
    font-size: 0.875rem;
    color: var(--bone-muted);
  }
</style>
