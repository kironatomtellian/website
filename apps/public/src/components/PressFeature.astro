---
export interface Quote {
  publication: string;
  quote: string;
  date: string;
  emphasis?: string;
}
export interface Props {
  lead: Quote;
  others: Quote[];
}
const { lead, others } = Astro.props;

// Each small quote opens its review, or the press page when there is no link.
import { withBase } from "../lib/url";
import press from "../data/press.json";
const linkFor = (q: Quote) =>
  press.quotes.find((p) => p.publication === q.publication && p.date === q.date && p.url)?.url ?? withBase("/press");

// One word of the lead quote can be set in italic vermilion.
const parts = lead.emphasis ? lead.quote.split(lead.emphasis) : [lead.quote];
---

<section class="press-feature bg-bone" aria-label="Press">
  <div class="container press-feature__inner">
    <p class="mono press-feature__source" data-fade>{lead.publication} · {lead.date}</p>
    <blockquote class="press-feature__lead" data-split>
      “{parts[0]}{lead.emphasis && parts.length > 1 && <em>{lead.emphasis}</em>}{parts.length > 1 && parts[1]}”
    </blockquote>

    <div class="press-feature__grid" data-stagger>
      {others.map((q) => (
        <a class="press-feature__item" href={linkFor(q)} target={linkFor(q).startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">
          <blockquote>“{q.quote}”</blockquote>
          <span class="press-feature__cap">{q.publication} · {q.date} <span class="press-feature__arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .press-feature__inner {
    padding-block: var(--section-y);
  }

  .press-feature__source {
    margin: 0 0 var(--space-8);
    color: var(--bone-muted);
  }

  .press-feature__lead {
    max-width: 18ch;
    font-family: var(--display);
    font-size: clamp(2.5rem, 6.2vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .press-feature__lead em {
    color: var(--vermilion-deep);
  }

  .press-feature__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-12);
    margin-top: var(--space-24);
    padding-top: var(--space-12);
    border-top: 1px solid var(--bone-rule);
  }

  .press-feature__item {
    display: block;
    margin: 0;
    transition: color 200ms;
  }

  .press-feature__item:hover {
    color: var(--vermilion-deep);
  }

  .press-feature__arrow {
    display: inline-block;
    transition: transform 400ms var(--ease-out-expo);
  }

  .press-feature__item:hover .press-feature__arrow {
    transform: translateX(6px);
  }

  .press-feature__item blockquote {
    margin: 0;
    font-family: var(--display);
    font-size: 1.625rem;
    line-height: 1.2;
  }

  .press-feature__cap {
    display: block;
    margin-top: var(--space-4);
    font-size: 0.875rem;
    color: var(--bone-muted);
  }
</style>
