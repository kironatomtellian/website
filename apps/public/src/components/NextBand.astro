---
import { withBase } from "../lib/url";
import { type Concert, cityOf, daysUntil, ensembleLabel, hallOf } from "../lib/concert";

export interface Props {
  concert?: Concert;
}
const { concert } = Astro.props;
const days = concert ? daysUntil(concert.date) : 0;
// A long gap reads as a quiet season, so the count only shows inside a month.
const when = days === 0 ? "Today" : days === 1 ? "Tomorrow" : days <= 30 ? `In ${days} days` : "Next concert";
---

{concert && (
  <a class="next-band" href={concert.ticketsUrl ?? withBase("/schedule")} data-next-date={concert.date}>
    <span class="container next-band__inner">
      <span class="mono next-band__when"><b class="next-band__dot pulse" aria-hidden="true"></b><span data-days>{when}</span></span>
      <span class="next-band__what">
        {ensembleLabel(concert) ?? "Concert"} · <em>{hallOf(concert)}</em> · {concert.displayDate}
      </span>
      <span class="next-band__cta arrow-host">{concert.ticketsUrl ? "Details & tickets" : cityOf(concert)} <span aria-hidden="true">→</span></span>
    </span>
  </a>
)}

<script>
  // The page is static, so the day count is refreshed in the visitor's browser.
  const el = document.querySelector<HTMLElement>("[data-next-date]");
  const out = el?.querySelector<HTMLElement>("[data-days]");
  if (el && out) {
    const d = new Date(el.dataset.nextDate + "T00:00:00");
    const t = new Date();
    t.setHours(0, 0, 0, 0);
    const n = Math.round((d.getTime() - t.getTime()) / 86400000);
    if (n >= 0) out.textContent = n === 0 ? "Today" : n === 1 ? "Tomorrow" : n <= 30 ? `In ${n} days` : "Next concert";
  }
</script>

<style>
  .next-band {
    display: block;
    background: var(--vermilion);
    color: var(--black);
  }

  /* Same first column as the concerts board below, so the band lines up with it. */
  .next-band__inner {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: baseline;
    padding-block: 1.5rem;
  }

  .next-band__dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.625rem;
    border-radius: 50%;
    background: var(--black);
  }

  .next-band__what {
    font-family: var(--display);
    font-size: clamp(1.625rem, 3vw, 2.5rem);
    line-height: 1.1;
  }

  .next-band__cta {
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .next-band:hover .next-band__cta {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 768px) {
    .next-band__inner { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
