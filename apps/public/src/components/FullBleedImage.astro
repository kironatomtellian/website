---
export interface Props {
  src: string;
  alt: string;
  height?: string;
}
const { src, alt, height = "70vh" } = Astro.props;
---

<section class="full-bleed reveal" aria-hidden={alt ? undefined : "true"}>
  <img class="full-bleed__img" src={src} alt={alt} style={`--h: ${height}`} loading="lazy" decoding="async" />
</section>

<style>
  .full-bleed {
    width: 100%;
    overflow: hidden;
  }

  .full-bleed__img {
    width: 100%;
    height: var(--h, 70vh);
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 768px) {
    .full-bleed__img {
      height: 60vh;
    }
  }
</style>
