---
import { withBase } from "../lib/url";
---

<footer class="site-footer bg-bone">
  <div class="container site-footer__inner">
    <a class="site-footer__book" href={withBase("/presenters")}>Book a <em>concert</em> <span aria-hidden="true">→</span></a>

    <div class="site-footer__contacts">
      <div>
        <p class="mono site-footer__label">General management</p>
        <p class="site-footer__name">Sabine Frank</p>
        <a class="site-footer__link" href="mailto:sabine.frank@harrisonparrott.de">sabine.frank@harrisonparrott.de</a>
        <p>+49 89 679710455</p>
      </div>
      <div>
        <p class="mono site-footer__label">HarrisonParrott GmbH</p>
        <p class="site-footer__name">Sofie Grimm</p>
        <a class="site-footer__link" href="mailto:sofie.grimm@harrisonparrott.de">sofie.grimm@harrisonparrott.de</a>
        <p>+49 1512 2123539</p>
      </div>
    </div>
  </div>

  <div class="container site-footer__base">
    <p>© {new Date().getFullYear()} Kiron Atom Tellian · Photos Shervin Lainez</p>
    <p class="site-footer__social">
      <a href="https://www.instagram.com/kironatomtellian/" target="_blank" rel="noopener noreferrer">Instagram</a>
      <a href="https://www.youtube.com/channel/UCgh0E-zCipS0smDr9FKus6g" target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href={withBase("/contact")}>Imprint</a>
    </p>
  </div>
</footer>

<style>
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-12);
    padding-block: var(--space-24) var(--space-16);
  }

  .site-footer__book {
    font-family: var(--display);
    font-size: clamp(3.5rem, 9vw, 9.5rem);
    line-height: 0.85;
    letter-spacing: -0.035em;
  }

  .site-footer__book em {
    color: var(--vermilion-deep);
  }

  .site-footer__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .site-footer__contacts p {
    margin: 0;
  }

  .site-footer__label {
    color: var(--bone-muted);
    margin-bottom: var(--space-2) !important;
  }

  .site-footer__name {
    font-weight: 600;
  }

  .site-footer__link {
    border-bottom: 1px solid var(--bone-rule);
  }

  .site-footer__link:hover,
  .site-footer__social a:hover,
  .site-footer__book:hover {
    color: var(--vermilion-deep);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--bone-rule);
    font-size: 0.875rem;
  }

  .site-footer__base p {
    margin: 0;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-6);
  }
</style>
