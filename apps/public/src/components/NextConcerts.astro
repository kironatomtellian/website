---
import { withBase } from "../lib/url";
import { type Concert, ensembleLabel, daysUntil } from "../lib/concert";

interface Quote {
  publication: string;
  quote: string;
  date: string;
}

export interface Props {
  concerts: Concert[];
  intros?: Quote[];
}
const { concerts, intros = [] } = Astro.props;

const featured = concerts[0];
const rest = concerts.slice(1);
const featuredDays = featured?.date ? daysUntil(featured.date) : null;
const showCount = featuredDays !== null && featuredDays >= 0 && featuredDays <= 10;
---

<section class="next-concerts bg-deep" aria-label="Upcoming concerts">
  <div class="container">
    {intros.length > 0 && (
      <ul class="next-concerts__intros reveal-stagger">
        {intros.map((q) => (
          <li>
            <figure class="next-concerts__intro">
              <p class="eyebrow accent">{q.publication}</p>
              <blockquote class="next-concerts__quote">
                <span class="accent">»</span>
                <span class="italic">{q.quote}</span>
                <span class="accent">«</span>
              </blockquote>
              <figcaption class="small muted italic">{q.date}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

    <div class="next-concerts__header reveal">
      <p class="eyebrow accent">Next Concerts</p>
    </div>

    {featured && (
      <article class="featured reveal">
        <div class="featured__top">
          <div class="featured__left">
            <p class="display-l featured__date">{featured.displayDate}</p>
            {ensembleLabel(featured) && (
              <p class="small muted featured__ensemble">{ensembleLabel(featured)}</p>
            )}
            <p class="h3 featured__programme">{featured.programme}</p>
          </div>
          {showCount && (
            <div class="featured__count">
              <span class="featured__count-num accent">{featuredDays}</span>
              <span class="eyebrow muted">{featuredDays === 1 ? "day" : "days"}</span>
            </div>
          )}
        </div>
        <div class="featured__bottom">
          <p class="featured__venue">{featured.venue}</p>
          {featured.ticketsUrl && (
            <a class="link-quiet featured__tickets" href={featured.ticketsUrl} target="_blank" rel="noopener">
              Details &amp; tickets <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </article>
    )}

    {rest.length > 0 && (
      <ul class="upcoming reveal-stagger">
        {rest.map((c) => (
          <li class="upcoming__row">
            <div class="upcoming__date">{c.displayDate}</div>
            <div class="upcoming__body">
              <div class="upcoming__venue">{c.venue}</div>
              {ensembleLabel(c) && (
                <div class="upcoming__ensemble small muted">{ensembleLabel(c)}</div>
              )}
              <div class="upcoming__programme">{c.programme}</div>
            </div>
            {c.ticketsUrl && (
              <a class="upcoming__link" href={c.ticketsUrl} target="_blank" rel="noopener">
                Tickets <span aria-hidden="true">→</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    )}

    <p class="next-concerts__cta reveal">
      <a class="link-quiet" href={withBase("/schedule")}>
        Full schedule <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .next-concerts {
    padding-block: var(--section-y);
  }

  .next-concerts__intros {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    margin: 0 auto var(--space-16);
    max-width: 1280px;
  }

  @media (min-width: 900px) {
    .next-concerts__intros {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12);
      align-items: start;
    }
  }

  .next-concerts__intro {
    margin: 0;
    text-align: center;
  }

  .next-concerts__quote {
    font-style: italic;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.45;
    margin: var(--space-2) 0 var(--space-2);
  }

  .next-concerts__header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .featured {
    border-top: 1px solid var(--rule-dark);
    border-bottom: 1px solid var(--rule-dark);
    padding-block: var(--space-8);
    max-width: 920px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .featured__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .featured__left {
    min-width: 0;
  }

  .featured__date {
    margin: 0 0 var(--space-1);
    color: var(--ink-light);
  }

  .featured__ensemble {
    margin: 0 0 var(--space-2);
    font-style: italic;
    color: var(--accent-soft);
  }

  .featured__programme {
    margin: 0;
    font-weight: 400;
    color: var(--ink-light);
  }

  .featured__count {
    text-align: right;
    flex-shrink: 0;
  }

  .featured__count-num {
    display: block;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .featured__bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .featured__venue {
    margin: 0;
    font-size: 1rem;
  }

  .upcoming {
    max-width: 920px;
    margin-inline: auto;
  }

  @media (min-width: 1280px) {
    .upcoming {
      max-width: 1320px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-12);
    }
    .featured {
      max-width: 1320px;
    }
  }

  .upcoming__row {
    display: grid;
    grid-template-columns: minmax(7rem, 9rem) 1fr auto;
    gap: var(--space-6);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule-dark);
    transition: padding-left var(--t-hover) var(--ease-out-expo);
  }

  .upcoming__row:hover {
    padding-left: var(--space-2);
  }

  .upcoming__date {
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    color: var(--ink-light);
  }

  .upcoming__body {
    min-width: 0;
  }

  .upcoming__venue {
    font-size: 1rem;
    color: var(--ink-light);
  }

  .upcoming__ensemble {
    margin-top: 2px;
    font-style: italic;
    color: var(--accent-soft);
  }

  .upcoming__programme {
    margin-top: 2px;
    font-size: 0.9375rem;
    font-style: normal;
    color: var(--muted-light);
  }

  .upcoming__link {
    font-size: 0.9375rem;
    color: var(--accent-soft);
    white-space: nowrap;
    position: relative;
    align-self: center;
  }

  .upcoming__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0.9em;
    bottom: -2px;
    height: 1px;
    background: var(--accent-soft);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-hover) var(--ease-out-expo);
  }

  .upcoming__link:hover::after {
    transform: scaleX(1);
  }

  .next-concerts__cta {
    text-align: center;
    margin-top: var(--space-12);
  }

  @media (max-width: 768px) {
    .featured__top {
      flex-direction: column;
    }
    .featured__count {
      text-align: left;
    }
    .featured__venue {
      font-size: 1.125rem;
    }

    .upcoming__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding-block: var(--space-6);
    }
    .upcoming__row:hover {
      padding-left: 0;
    }
    .upcoming__date {
      font-size: 1rem;
    }
    .upcoming__venue {
      font-size: 1.125rem;
    }
    .upcoming__ensemble,
    .upcoming__programme {
      font-size: 1rem;
    }
    .upcoming__link {
      font-size: 1rem;
    }
  }
</style>
