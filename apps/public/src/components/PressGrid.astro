---
export interface Quote {
  publication: string;
  quote: string;
  date: string;
}
export interface Props {
  quotes: Quote[];
}
const { quotes } = Astro.props;
---

<section class="press-grid reveal" aria-label="More press">
  <div class="container">
    <p class="eyebrow accent press-grid__eyebrow">In the press</p>
    <ul class="press-grid__list">
      {quotes.map((q) => (
        <li class="press-grid__item">
          <figure class="press-grid__figure">
            <p class="eyebrow accent press-grid__pub">{q.publication}</p>
            <blockquote class="press-grid__quote">
              <span class="press-grid__mark" aria-hidden="true">»</span>
              <span class="press-grid__inner">{q.quote}</span>
              <span class="press-grid__mark press-grid__mark--end" aria-hidden="true">«</span>
            </blockquote>
            <figcaption class="small muted press-grid__date">{q.date}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .press-grid {
    display: none;
    padding-block: var(--section-y) var(--section-y-tight);
  }

  .press-grid__eyebrow {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .press-grid__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-12) var(--space-8);
    max-width: 1200px;
    margin-inline: auto;
  }

  .press-grid__figure {
    margin: 0;
    text-align: center;
  }

  .press-grid__pub {
    margin-bottom: var(--space-2);
    display: inline-block;
  }

  .press-grid__quote {
    margin: 0 0 var(--space-3);
    font-size: clamp(1rem, 1.1vw, 1.125rem);
    line-height: 1.45;
  }

  .press-grid__mark {
    color: var(--accent-soft);
    font-size: 1.15em;
    line-height: 1;
    margin-right: 0.12em;
  }

  .press-grid__mark--end {
    margin-right: 0;
    margin-left: 0.12em;
  }

  .press-grid__date {
    font-style: italic;
  }

  @media (min-width: 1024px) {
    .press-grid {
      display: block;
    }
  }

  @media (min-width: 1024px) and (max-width: 1199px) {
    .press-grid__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
