---
import { withBase } from "../lib/url";
import { type Concert, cityOf, ensembleLabel, hallOf } from "../lib/concert";

export interface Props {
  concerts: Concert[];
  /** Concerts already played, oldest first. Shown above a "Now" line so the board never looks empty. */
  recent?: Concert[];
  total: number;
  title?: string;
  intro?: string;
}
const { concerts, recent = [], total, title = "Season", intro } = Astro.props;

// Consecutive nights at the same hall become one row: "01 + 03.04.27".
type Row = { first: Concert; dates: Concert[] };
const group = (list: Concert[]) => {
  const rows: Row[] = [];
  for (const c of list) {
    const prev = rows[rows.length - 1];
    if (prev && prev.first.venue === c.venue && prev.first.programme === c.programme) {
      prev.dates.push(c);
    } else {
      rows.push({ first: c, dates: [c] });
    }
  }
  return rows;
};
const pastRows = group(recent);
const rows = group(concerts);
const what = (c: Concert) =>
  c.programme === "To be announced" ? ensembleLabel(c) ?? "Programme to be announced" : c.programme;
const withLine = (c: Concert) => (c.programme === "To be announced" ? c.venue : ensembleLabel(c));

const fmt = (iso: string) => {
  const [y, m, d] = iso.split("-");
  return `${d}.${m}.${y.slice(2)}`;
};
const dateLabel = (r: Row) => {
  if (r.dates.length === 1) return fmt(r.first.date);
  const days = r.dates.map((c) => c.date.slice(8, 10));
  const tail = fmt(r.dates[r.dates.length - 1].date).slice(2);
  return r.dates.length === 2 ? `${days[0]} + ${days[1]}${tail}` : `${days[0]}–${days[days.length - 1]}${tail}`;
};
---

<section class="season container" aria-labelledby="season-title">
  <div class="season__head">
    <h2 id="season-title" class="display-xl season__title" set:html={title} />
    {intro && <p class="season__intro">{intro}</p>}
  </div>

  <ol class="season__rows">
    {pastRows.map((r) => (
      <li>
        <div class="season__row season__row--past">
          <span class="season__date">{dateLabel(r)}<span class="season__played">Played</span></span>
          <span class="season__city">{cityOf(r.first)}</span>
          <span class="season__what">
            {r.first.programme === "To be announced" ? ensembleLabel(r.first) ?? "Recital" : r.first.programme}
            <span class="season__with">{r.first.programme === "To be announced" ? hallOf(r.first) : ensembleLabel(r.first)}</span>
          </span>
          <span class="season__arrow" aria-hidden="true"></span>
        </div>
      </li>
    ))}
    {pastRows.length > 0 && (
      <li class="season__now" aria-hidden="true"><span class="mono">Now</span></li>
    )}
    {rows.map((r) => (
      <li>
        <a class="season__row" href={r.first.ticketsUrl ?? withBase("/schedule")}>
          <span class="season__date">{dateLabel(r)}</span>
          <span class="season__city">{cityOf(r.first)}</span>
          <span class="season__what">
            {what(r.first)}
            <span class="season__with">{withLine(r.first)}</span>
          </span>
          <span class="season__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>

  <a class="link-line season__all" href={withBase("/schedule")}>Full season · {total} dates →</a>
</section>

<style>
  .season {
    padding-block: var(--section-y) var(--space-20);
  }

  .season__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .season__title {
    margin: 0;
  }

  .season__title :global(em) {
    font-style: italic;
  }

  .season__intro {
    max-width: 22rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .season__rows {
    border-top: 1px solid var(--rule);
  }

  .season__row {
    display: grid;
    grid-template-columns: minmax(7.5rem, 1fr) minmax(0, 2.2fr) minmax(0, 2.6fr) auto;
    gap: var(--space-6);
    align-items: baseline;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
    transition: padding-left var(--t-hover) var(--ease-out-expo);
  }

  .season__row:hover {
    padding-left: var(--space-2);
  }

  .season__row:hover .season__arrow {
    color: var(--accent);
  }

  .season__date {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .season__city {
    font-family: var(--display);
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1;
  }

  .season__what {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    line-height: 1.45;
  }

  .season__with {
    color: var(--muted);
  }

  .season__arrow {
    font-size: 1.25rem;
  }

  .season__row--past {
    color: var(--muted);
  }

  .season__row--past:hover {
    padding-left: 0;
  }

  .season__row--past .season__city {
    opacity: 0.7;
  }

  .season__played {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .season__now {
    position: relative;
    height: 0;
    border-top: 1px solid var(--accent);
    margin-top: -1px;
  }

  .season__now span {
    position: absolute;
    top: -0.7rem;
    left: 0;
    padding-right: var(--space-3);
    background: var(--paper);
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .season__all {
    margin-top: var(--space-8);
  }

  @media (max-width: 768px) {
    .season__row {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-4);
    }
    .season__date { grid-column: 1 / -1; }
    .season__what { grid-column: 1 / -1; }
    .season__arrow { grid-row: 2; grid-column: 2; }
  }
</style>
