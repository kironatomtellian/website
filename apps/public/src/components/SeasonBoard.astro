---
import { withBase } from "../lib/url";
import { type Concert, cityOf, groupRuns, runLabel, whatOf as what, withLineOf as withLine } from "../lib/concert";

export interface Props {
  concerts: Concert[];
  /** Concerts already played, oldest first. Shown above a "Now" line so the board never looks empty. */
  recent?: Concert[];
  total: number;
  title?: string;
  intro?: string;
}
const { concerts, recent = [], total, title = "Season", intro } = Astro.props;

const pastRows = groupRuns(recent);
const rows = groupRuns(concerts);
---

<section class="season container" aria-labelledby="season-title">
  <div class="season__head">
    <h2 id="season-title" class="display-xl season__title" data-split set:html={title} />
    {intro && <p class="season__intro" data-fade>{intro}</p>}
  </div>

  <ol class="season__rows" data-stagger>
    {pastRows.map((r) => (
      <li>
        <div class="season__row season__row--past">
          <span class="season__date">{runLabel(r).days}<span class="season__sub">{runLabel(r).sub}</span></span>
          <span class="season__city">{cityOf(r[0])}</span>
          <span class="season__what">
            {what(r[0])}
            <span class="season__with">{withLine(r[0])}</span>
          </span>
          <span class="season__arrow" aria-hidden="true"></span>
        </div>
      </li>
    ))}
    {pastRows.length > 0 && (
      <li class="season__now" aria-hidden="true"><i class="season__now-line" data-draw></i><span class="mono"><b class="season__now-dot pulse"></b>Now</span></li>
    )}
    {rows.map((r) => (
      <li>
        <a class="season__row row-sweep" href={r[0].ticketsUrl ?? withBase("/schedule")}>
          <span class="season__date">{runLabel(r).days}<span class="season__sub">{runLabel(r).sub}</span></span>
          <span class="season__city">{cityOf(r[0])}</span>
          <span class="season__what">
            {what(r[0])}
            <span class="season__with">{withLine(r[0])}</span>
          </span>
          <span class="season__arrow arrow-slide" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>

  <a class="link-line season__all" href={withBase("/schedule")}>Full season · {total} dates →</a>
</section>

<style>
  .season {
    padding-block: var(--section-y) var(--space-20);
  }

  /* Head and rows share one grid, so the intro sits over the programme column. */
  .season__head,
  .season__row {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 2.2fr) minmax(0, 2.6fr) 1.5rem;
    gap: var(--space-6);
  }

  .season__head {
    align-items: end;
    margin-bottom: var(--space-12);
  }

  .season__title {
    grid-column: 1 / 3;
  }

  .season__title {
    margin: 0;
  }

  .season__title :global(em) {
    font-style: italic;
  }

  .season__intro {
    grid-column: 3 / 5;
    max-width: 30rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .season__rows {
    border-top: 1px solid var(--rule);
  }

  .season__row {
    align-items: start;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
    transition: padding-left var(--t-hover) var(--ease-out-expo);
  }

  .season__row:hover {
    padding-left: var(--space-2);
  }

  .season__row:hover .season__arrow {
    color: var(--accent);
  }

  .season__date {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 0.375rem;
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .season__sub {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .season__city {
    font-family: var(--display);
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1;
  }

  .season__what {
    padding-top: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    line-height: 1.45;
  }

  .season__with {
    color: var(--muted);
  }

  .season__arrow {
    font-size: 1.25rem;
  }

  .season__row--past {
    color: var(--muted);
  }

  .season__row--past:hover {
    padding-left: 0;
  }

  .season__row--past .season__city {
    opacity: 0.7;
  }

  .season__now {
    position: relative;
    height: 0;
    margin-top: -1px;
  }

  .season__now-line {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--accent);
  }

  .season__now-dot {
    display: inline-block;
    width: 0.4375rem;
    height: 0.4375rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.0625rem;
  }

  .season__now span {
    position: absolute;
    top: -0.7rem;
    left: 0;
    padding-right: var(--space-3);
    background: var(--paper);
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .season__all {
    margin-top: var(--space-8);
  }

  @media (max-width: 768px) {
    .season__head { grid-template-columns: 1fr; }
    .season__title, .season__intro { grid-column: 1; }
    .season__row {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-4);
    }
    .season__date { grid-column: 1 / -1; }
    .season__what { grid-column: 1 / -1; }
    .season__arrow { grid-row: 2; grid-column: 2; }
  }
</style>
