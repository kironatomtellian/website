---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/type.css";
import "../styles/motion.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";

export interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = "Kiron Atom Tellian — Austrian pianist and composer.",
  bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <link rel="apple-touch-icon" href={withBase("/favicon.png")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Libre+Caslon+Display&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link rel="alternate" type="text/calendar" title="Concert calendar" href={withBase("/schedule.ics")} />
    <title>{title}</title>
    <meta name="theme-color" content="#0b0b0b" />
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion");
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <div class="cursor-dot" data-cursor-dot aria-hidden="true"><span></span></div>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
